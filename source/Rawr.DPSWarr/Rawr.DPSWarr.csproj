<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Rawr.DPSWarr</AssemblyName>
    <RootNamespace>Rawr.DPSWarr</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>1</WarningLevel>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS1591;CS0162;CS0168;CS0219;CS0414;CS0649;CS0169;CS0108;CS0105;SYSLIB0014</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Deterministic>true</Deterministic>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PathMap>$(MSBuildProjectDirectory)=/src/Rawr.DPSWarr</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CalculationOptionsDPSWarr.cs" />
    <Compile Include="Markov\BloodSurgeMatrix.cs" />
    <Compile Include="Markov\FuryGenerator.cs" />
    <Compile Include="CombatTable.cs" />
    <Compile Include="Markov\StateSpaceArms.cs" />
    <Compile Include="Rotation.Arms.cs" />
    <Compile Include="Rotation.Fury.cs" />
    <Compile Include="Skills.Shared.cs" />
    <Compile Include="Skills.Arms.cs" />
    <Compile Include="CalculationOptionsPanelDPSWarr.cs" />
    <Compile Include="CalculationOptionsPanelDPSWarr.Designer.cs" />
    <Compile Include="CalculationsDPSWarr.cs" />
    <Compile Include="CharacterCalculationsDPSWarr.cs" />
    <Compile Include="CombatFactors.cs" />
    <Compile Include="ComparisonCalculationsDPSWarr.cs" />
    <Compile Include="Skills.Fury.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Rotation.cs" />
    <Compile Include="Skills.Base.cs" />
    <Compile Include="Skills.Prot.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="CalculationOptionsPanelDPSWarr.resx">
      <DependentUpon>CalculationOptionsPanelDPSWarr.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rawr.Base\Rawr.Base.csproj" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>
</Project>
