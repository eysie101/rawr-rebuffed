<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Rawr.Hunter</AssemblyName>
    <RootNamespace>Rawr.Hunter</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>1</WarningLevel>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS1591;CS0162;CS0168;CS0219;CS0414;CS0649;CS0169;CS0108;CS0105;SYSLIB0014</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Deterministic>true</Deterministic>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PathMap>$(MSBuildProjectDirectory)=/src/Rawr.Hunter</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CalculationOptionsHunter.cs" />
    <Compile Include="CalculationOptionsPanelHunter.cs" />
    <Compile Include="CalculationOptionsPanelHunter.Designer.cs" />
    <Compile Include="CalculationsHunter.cs" />
    <Compile Include="CharacterCalculationsHunter.cs" />
    <Compile Include="CombatFactors.cs" />
    <Compile Include="CombatTable.cs" />
    <Compile Include="ComparisonCalculationHunter.cs" />
    <Compile Include="HunterEnums.cs" />
    <Compile Include="Pet\FormSavePetTalentSpec.cs" />
    <Compile Include="Pet\FormSavePetTalentSpec.Designer.cs" />
    <Compile Include="Pet\ItemIconsPet.cs" />
    <Compile Include="Pet\PetBuffSelector.cs" />
    <Compile Include="Pet\PetBuffSelector.Designer.cs" />
    <Compile Include="Pet\PetCalculations.cs" />
    <Compile Include="Pet\PetSkill.cs" />
    <Compile Include="Pet\PetTalents.cs" />
    <Compile Include="Pet\SavedPetTalentSpec.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs" />
    <Compile Include="Properties\Settings.Designer.cs" />
    <Compile Include="Rotation.cs" />
    <Compile Include="RotationTest.cs" />
    <Compile Include="ShotData.cs" />
    <Compile Include="ShotPriority.cs" />
    <Compile Include="Skills.Base.cs" />
    <Compile Include="Skills.Shots.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="CalculationOptionsPanelHunter.resx">
      <DependentUpon>CalculationOptionsPanelHunter.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Pet\FormSavePetTalentSpec.resx">
      <DependentUpon>FormSavePetTalentSpec.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Pet\PetBuffSelector.resx">
      <DependentUpon>PetBuffSelector.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties\Resources.resx" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Properties\Settings.settings" />
    <None Include="Resources\bgCunning.jpg" />
    <None Include="Resources\bgFerocity.jpg" />
    <None Include="Resources\bgTenacity.jpg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rawr.Base\Rawr.Base.csproj" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>
</Project>
