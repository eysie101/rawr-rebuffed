<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Rawr.Warlock</AssemblyName>
    <RootNamespace>Rawr.Warlock</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>1</WarningLevel>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS1591;CS0162;CS0168;CS0219;CS0414;CS0649;CS0169;CS0108;CS0105;SYSLIB0014</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Deterministic>true</Deterministic>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PathMap>$(MSBuildProjectDirectory)=/src/Rawr.Warlock</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CalculationOptionsPanelWarlock.cs" />
    <Compile Include="CalculationOptionsPanelWarlock.Designer.cs" />
    <Compile Include="CalculationOptionsWarlock.cs" />
    <Compile Include="CalculationsWarlock.cs" />
    <Compile Include="CastingState.cs" />
    <Compile Include="CharacterCalculationsWarlock.cs" />
    <Compile Include="ComparisonCalculationWarlock.cs" />
    <Compile Include="Pets.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="SimulatedStat.cs" />
    <Compile Include="Spells.cs" />
    <Compile Include="StatUtils.cs" />
    <Compile Include="TextInputDialog.cs" />
    <Compile Include="TextInputDialog.Designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="CalculationOptionsPanelWarlock.resx">
      <DependentUpon>CalculationOptionsPanelWarlock.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="TextInputDialog.resx">
      <DependentUpon>TextInputDialog.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rawr.Base\Rawr.Base.csproj" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>
</Project>
